(defwidget rw-button-button-card [wid]
  (eventbox :class "gen-button-box" :cursor "pointer"
    :onclick "@CTL@ run ${wid} &"
    (box :class "card gen gen-button accent-${wcfg.o[wid]?.accent_class ?: 'primary'}" :orientation "h"
      :space-evenly false :spacing 14 :style "min-width: ${wcfg.o[wid]?.inner ?: 222}px;"
      (label :class "gen-button-icon" :text {wcfg.o[wid]?.icon ?: ""})
      (box :orientation "v" :space-evenly false :valign "center" :hexpand true
        (label :class "gen-title" :halign "start" :text {wcfg.o[wid]?.title ?: ""})
        (label :class "gen-sub" :halign "start" :visible {(wcfg.o[wid]?.subtitle ?: "") != ""}
          :text {wcfg.o[wid]?.subtitle ?: ""})))))

(defwindow rw-button [wid]
  :monitor 0 :geometry (geometry :x "64px" :y "110px" :width "0px" :height "0px" :anchor "top left")
  :stacking "bg" :exclusive false :focusable false :namespace "@NAMESPACE@${wid}"
  (box :orientation "v" :space-evenly false :class "rw-desktop rw-button wroot ${wcfg.o[wid]?.fx_class ?: ''} ${wcfg.o[wid]?.anim_class ?: ''} ${wcfg.o[wid]?.skin_class ?: 'skin-bento'}" :style {wcfg.o[wid]?.power_style ?: ""} (rw-button-button-card :wid wid)
    (label :class "rw-error" :visible {(wcfg.g[wid]?.error ?: "") != ""} :limit-width 42 :text {wcfg.g[wid]?.error ?: ""})))
