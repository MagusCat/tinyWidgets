(defwidget rw-note-note-card [wid]
  (box :class "card gen accent-${wcfg.o[wid]?.accent_class ?: 'primary'}" :orientation "v"
    :space-evenly false :spacing 10 :style "min-width: ${wcfg.o[wid]?.inner ?: 282}px;"
    (rw-shared-gen-head :wid wid)
    (label :class "gen-note font-${wcfg.o[wid]?.font_class ?: 'medium'}" :halign "start" :xalign 0
      :text {wcfg.g[wid]?.text ?: ""})))

(defwindow rw-note [wid]
  :monitor 0 :geometry (geometry :x "64px" :y "110px" :width "0px" :height "0px" :anchor "top left")
  :stacking "bg" :exclusive false :focusable false :namespace "@NAMESPACE@${wid}"
  (box :orientation "v" :space-evenly false :class "rw-desktop rw-note wroot ${wcfg.o[wid]?.fx_class ?: ''} ${wcfg.o[wid]?.anim_class ?: ''} ${wcfg.o[wid]?.skin_class ?: 'skin-bento'}" :style {wcfg.o[wid]?.power_style ?: ""} (rw-note-note-card :wid wid)
    (label :class "rw-error" :visible {(wcfg.g[wid]?.error ?: "") != ""} :limit-width 42 :text {wcfg.g[wid]?.error ?: ""})))
