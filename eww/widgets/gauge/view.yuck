(defwidget rw-gauge-gauge-card [wid]
  (box :class "card gen accent-${wcfg.o[wid]?.accent_class ?: 'primary'}" :orientation "v"
    :space-evenly false :spacing 10 :style "min-width: ${wcfg.o[wid]?.inner ?: 222}px;"
    (rw-shared-gen-head :wid wid)
    (box :visible {(wcfg.o[wid]?.style ?: "Anillo") == "Anillo"} :halign "center"
      (circular-progress :class "gen-ring" :value {wcfg.g[wid]?.pct ?: 0} :thickness 9 :start-at 75
        :width 110 :height 110
        (label :class "gen-ring-value" :text {wcfg.g[wid]?.text ?: "…"})))
    (box :visible {(wcfg.o[wid]?.style ?: "Anillo") == "Barra"} :orientation "v" :space-evenly false :spacing 8
      (label :class "gen-big" :halign "start" :text {wcfg.g[wid]?.text ?: "…"})
      (progress :class "gen-bar" :orientation "h" :value {wcfg.g[wid]?.pct ?: 0}))))

(defwindow rw-gauge [wid]
  :monitor 0 :geometry (geometry :x "64px" :y "110px" :width "0px" :height "0px" :anchor "top left")
  :stacking "bg" :exclusive false :focusable false :namespace "@NAMESPACE@${wid}"
  (box :orientation "v" :space-evenly false :class "rw-desktop rw-gauge wroot ${wcfg.o[wid]?.fx_class ?: ''} ${wcfg.o[wid]?.anim_class ?: ''} ${wcfg.o[wid]?.skin_class ?: 'skin-bento'}" :style {wcfg.o[wid]?.power_style ?: ""} (rw-gauge-gauge-card :wid wid)
    (label :class "rw-error" :visible {(wcfg.g[wid]?.error ?: "") != ""} :limit-width 42 :text {wcfg.g[wid]?.error ?: ""})))
