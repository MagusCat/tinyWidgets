(defwidget rw-apps-app-item [app show_label style]
  (eventbox :class "app-item-box" :cursor "pointer" :onclick "${app.cmd}"
    (box :class "app-btn ${style}" :orientation {style == 'pills' ? 'h' : 'v'} :space-evenly false :spacing 6 :tooltip {app.name}
      (label :class "app-icon" :text {app.icon})
      (label :class "app-name" :visible {show_label == "yes"} :text {app.name}))))

(defwidget rw-apps-apps-card [wid]
  (box :class "card gen apps-card ${(wcfg.o[wid]?.card_class ?: '')} ${(wcfg.o[wid]?.pad_class ?: '')} accent-${wcfg.o[wid]?.accent_class ?: 'primary'}"
    :orientation "v" :space-evenly false :spacing 10
    :style "min-width: ${wcfg.o[wid]?.inner ?: 320}px;"
    (rw-shared-gen-head :wid wid)
    (box :class "apps-container ${(wcfg.o[wid]?.style ?: 'Dock horizontal') == 'Cuadrícula 2x4' ? 'grid' : 'dock'}"
      :orientation "h" :space-evenly true :spacing 8
      (for app in {wcfg.g[wid]?.apps ?: []}
        (rw-apps-app-item :app app :show_label {wcfg.o[wid]?.labels ?: "no"} :style {(wcfg.o[wid]?.style ?: "Dock horizontal") == "Píldoras con nombres" ? "pills" : "icon-only"})))))

(defwindow rw-apps [wid]
  :monitor 0 :geometry (geometry :x "64px" :y "110px" :width "0px" :height "0px" :anchor "top left")
  :stacking "bg" :exclusive false :focusable false :namespace "@NAMESPACE@${wid}"
  (box :orientation "v" :space-evenly false :class "rw-desktop rw-apps wroot ${wcfg.o[wid]?.fx_class ?: ''} ${wcfg.o[wid]?.anim_class ?: ''} ${wcfg.o[wid]?.skin_class ?: 'skin-bento'}" :style {wcfg.o[wid]?.power_style ?: ""} (rw-apps-apps-card :wid wid)
    (label :class "rw-error" :visible {(wcfg.g[wid]?.error ?: "") != ""} :limit-width 42 :text {wcfg.g[wid]?.error ?: ""})))
